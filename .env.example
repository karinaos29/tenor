# Copy to .env (repo root) and fill in. Never commit .env.
# Every key is optional: the Start screen shows which services are ready.

# Speech-to-text (streaming, diarization). https://console.deepgram.com
DEEPGRAM_API_KEY=

# LLM: Google Gemini via a Google AI Studio key (billing enabled). https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Market data for real tickers. https://finnhub.io
FINNHUB_API_KEY=

# Email for the post-call memo. https://resend.com
RESEND_API_KEY=

# Optional: override the Gemini model per job (defaults in backend/app/config.py, reasons in ai.md)
# TENOR_MODEL_FAST=gemini-3.5-flash-lite,gemini-3.1-flash-lite   # hedged: first valid answer wins
# TENOR_LLM_TIMEOUT_S=8
# TENOR_WORDING_TIMEOUT_S=6
# FINNHUB_TIMEOUT_S=3
# TENOR_MODEL_MEMO=gemini-3.8-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
# TENOR_MEMO_TIMEOUT_S=20

# Optional: email sender and a recipient to prefill (Resend's sandbox only delivers to your own address)
# MEMO_EMAIL_FROM=Tenor <onboarding@resend.dev>
# MEMO_EMAIL_TO=

# Hosting only (frontend on Vercel, backend on Railway). Leave empty locally.
# ALLOWED_ORIGINS=https://your-project.vercel.app   # browser origins allowed to use the API and sockets
# TENOR_DATA_DIR=/data                              # where saved calls live (SQLite); the Docker image sets /data
