# Copy to .env (repo root) and fill in. Never commit .env.
# Every key is optional at M0: the Start screen shows which services are ready.

# Speech-to-text (streaming, diarization). https://console.deepgram.com
DEEPGRAM_API_KEY=

# LLM: Google Gemini via a Google AI Studio key (billing enabled). https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Market data for real tickers. https://finnhub.io
FINNHUB_API_KEY=

# Email for the post-call memo. https://resend.com
RESEND_API_KEY=

# Optional: override the Gemini model per job (defaults in backend/app/config.py, reasons in ai.md)
# TENOR_MODEL_FAST=gemini-3.1-flash-lite
# TENOR_LLM_TIMEOUT_S=8
# TENOR_MODEL_RESEARCH=gemini-3.8-flash
# TENOR_MODEL_MEMO=gemini-3.8-flash
