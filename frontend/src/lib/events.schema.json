        },
        "utterance_id": {
          "type": "string"
        },
        "status": {
          "default": "checking",
          "enum": [
            "checking",
            "verified",
            "false",
            "not_found",
            "unverifiable"
          ],
          "type": "string"
        },
        "actual_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "checked_in_ms": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Plain-words detail of the check, e.g. 'last 13 weeks'"
        }
      },
      "required": [
        "id",
        "text",
        "metric",
        "claimed_value",
        "unit",
        "period",
        "subject",
        "utterance_id",
        "status",
        "actual_value",
        "source",
        "checked_in_ms",
        "note"
