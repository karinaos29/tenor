        "type": {
          "const": "call.ended",
          "default": "call.ended",
          "type": "string"
        },
        "reason": {
          "enum": [
            "user",
            "replay_finished",
            "error"
          ],
          "type": "string"
        },
        "detail": {
          "default": "",
          "type": "string"
        }
      },
      "required": [
        "ts",
        "type",
        "reason",
        "detail"
      ],
      "title": "CallEnded",
      "type": "object"
    },
