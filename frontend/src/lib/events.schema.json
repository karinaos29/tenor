{
  "title": "TenorWire",
  "description": "Every type that crosses the wire. Generated root; import the member types.",
  "type": "object",
  "properties": {
    "event": {
      "$ref": "#/$defs/TenorEvent"
    },
    "replayList": {
      "$ref": "#/$defs/ReplayList"
    },
    "evalResponse": {
